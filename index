function calcScores(answers) {
const byGifting = {};
QUESTIONS.forEach((q, i) => {
if (answers[i] !== undefined) {
if (!byGifting[q.giftingId]) byGifting[q.giftingId] = [];
byGifting[q.giftingId].push(answers[i]);
}
});
return GIFTINGS.map(g => {
const scores = byGifting[g.id] || [];
const top2 = […scores].sort((a,b)=>b-a).slice(0,2);
const avg = top2.length ? top2.reduce((a,b)=>a+b,0)/top2.length : 0;
return {…g, score:avg, pct:Math.round((avg/4)*100)};
}).sort((a,b)=>b.score-a.score);
}

